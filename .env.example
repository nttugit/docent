# Copy to .env and fill in. Never commit .env.
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO

# Day 3 — Supabase (Postgres + pgvector), dùng pooler connection string
DATABASE_URL=

# Day 3/9 — Hugging Face
HF_TOKEN=

# Day 5 — Gemini (google-genai SDK đọc GEMINI_API_KEY)
GEMINI_API_KEY=

# Day 8 — Weights & Biases
WANDB_API_KEY=

# Day 11 — GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Day 12 — Langfuse (kiểm tra: SDK mới có thể dùng LANGFUSE_BASE_URL thay cho HOST)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
